{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snap Herb",
  "version": "0.1.0",
  "identifier": "com.snapherb.desktop",
  "build": {
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": "../app" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build", "cwd": "../app" },
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Snap Herb - ใบเบิกยาสมุนไพร",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Medical",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
